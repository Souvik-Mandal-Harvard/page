---
import { siGithub, siGooglescholar, siX, siYoutube } from 'simple-icons';
import type { SocialKey } from '../data/profile';

interface Props {
  name: SocialKey | 'email';
  size?: number;
}

const { name, size = 20 } = Astro.props;

// LinkedIn isn't in simple-icons (brand policy), so its path is inlined.
const paths: Record<SocialKey, string> = {
  github: siGithub.path,
  scholar: siGooglescholar.path,
  x: siX.path,
  youtube: siYoutube.path,
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z',
};
---

{
  name === 'email' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </svg>
  ) : (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={paths[name]} />
    </svg>
  )
}
