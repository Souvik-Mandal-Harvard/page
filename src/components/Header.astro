---
import { getPosts } from '../lib';

const posts = await getPosts();
const links = [
  { href: '/#care', label: 'Mission' },
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#about', label: 'About' },
  { href: '/#beyond', label: 'Beyond work' },
  ...(posts.length ? [{ href: '/#writing', label: 'Writing' }] : []),
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__name">Souvik Mandal</a>

    <div class="site-header__actions">
      <nav class="site-nav site-nav--wide" aria-label="Main">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/#contact" class="button button--small">Contact</a>
      </nav>

      <details class="site-nav site-nav--narrow">
        <summary>Menu</summary>
        <nav aria-label="Main">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/#contact">Contact</a>
        </nav>
      </details>

      <button type="button" class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after picking a section so it doesn't cover the page.
  const menu = document.querySelector<HTMLDetailsElement>('.site-nav--narrow');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.open = false;
  });

  // The page follows the system setting until the visitor picks a theme here.
  // Base.astro restores a saved choice before first paint.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';

  function syncTheme() {
    const dark = isDark();
    toggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
    toggle?.setAttribute('title', `Switch to ${dark ? 'light' : 'dark'} mode`);
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = dark ? '#111413' : '#faf8f4'));
  }

  toggle?.addEventListener('click', () => {
    const theme = isDark() ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Blocked storage: the choice still applies to this page.
    }
    // Keeps the portrait in step with the toggle (see ThemePortrait.astro).
    document.querySelectorAll<HTMLSourceElement>('source[data-dark]').forEach((s) => (s.media = theme === 'dark' ? 'all' : 'not all'));
    syncTheme();
  });

  systemDark.addEventListener('change', syncTheme);
  syncTheme();
</script>
