pe != (H, W):\n            m = cv2.resize(m.astype(np.uint8), (W, H), interpolation=cv2.INTER_NEAREST) > 0\n    if m is not None and m.any():\n        ys, xs = np.nonzero(m)\n        area = m.sum()\n        rows.append((fr, xs.mean(), ys.mean(), area, 2 * np.sqrt(area / np.pi)))\n        mask_by_frame[fr] = m\n    else:\n        rows.append((fr, np.nan, np.nan, 0, np.nan))\n\nsam = pd.DataFrame(rows, columns=[\"frame\", \"x\", \"y\", \"area\", \"d_px\"])\nprint(f\"masks found in {sam.x.notna().sum()} / {len(sam)} frames\")\n\nshown = np.linspace(PROMPT_FRAME, sam.frame.max(), 12).astype(int)\nfig, axes = plt.subplots(3, 4, figsize=(22, 9))\nfor ax, i in zip(axes.ravel(), shown):\n    ax.imshow(cv2.cvtColor(frames[i], cv2.COLOR_BGR2RGB))\n    if i in mask_by_frame:\n        ax.contour(mask_by_frame[i], levels=[0.5], colors=\"red\", linewidths=1.5)\n    ax.set_title(f\"frame {i}\"); ax.axis(\"off\")\nplt.tight_layout(); plt.show()\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 3))\naxes[0].plot(sam.frame, sam.area, \".-\"); axes[0].set_ylabel(\"mask area (px)\")\naxes[1].plot(sam.frame, sam.y, \".-\"); axes[1].invert_yaxis(); axes[1].set_ylabel(\"y (px, up = higher)\")\nfor a in axes:\n    a.set_xlabel(\"frame\"); a.grid(alpha=.4)\nplt.show()","key":"UPEVbbXz7U"},{"type":"outputs","id":"AiNttgVziQNCtuNFdlKH9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"masks found in 26 / 126 frames\n"},"children":[],"key":"WiFKlKYRVd"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7738fb8376f7c4d74cf5ec92b4290a44","path":"/teaching-learning/ls100/build/7738fb8376f7c4d74cf5ec92b4290a44.png"},"text/plain":{"content":"<Figure size 2200x900 with 12 Axes>","content_type":"text/plain"}}},"children":[],"key":"B6kLfjH14N"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"61690a7