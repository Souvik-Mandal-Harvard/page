\nframes = []\nwhile True:\n    ok, f = cap.read()\n    if not ok:\n        break\n    frames.append(f)\nfps = cap.get(cv2.CAP_PROP_FPS)\ncap.release()\nH, W = frames[0].shape[:2]\nprint(f\"{len(frames)} frames, {W}x{H}, {fps:.2f} fps, device={DEVICE}\")","key":"bBGdQfgaYY"},{"type":"outputs","id":"dcXHRCccoAOU2mC6Miv6p","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"222 frames, 1420x400, 59.94 fps, device=mps\n"},"children":[],"key":"bDKjRJzbPI"}],"key":"XYvz4GIzSp"}],"identifier":"0d7039fd","html_id":"0d7039fd","key":"J9QVZGe7Cv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 2: Choose the frame and click point","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kcUDKw7jrr"}],"identifier":"step-2-choose-the-frame-and-click-point","label":"Step 2: Choose the frame and click point","html_id":"step-2-choose-the-frame-and-click-point","implicit":true,"key":"I06nJz2fC9"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Set ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gQHuavBOlS"},{"type":"inlineCode","value":"PROMPT_FRAME","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cJjaSkChJh"},{"type":"text","value":" to a frame where the ball is clearly visible, and ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"GJkJ9pB9I4"},{"type":"inlineCode","value":"PROMPT_POINT","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tQYcGptsJh"},{"type":"text","value":" to ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZFfQmJqYC9"},{"type":"inlineCode","value":"(x, y)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QPUFGUmYw2"},{"type":"text","value":" pixel coordinates on the ball (read from the grid). SAM 2 tracks forward from this frame, so choose the earliest frame you need, for example just before release. Re-run this cell until the red cross sits on the ball.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Wx37qQri7Z"}],"key":"H9fBZCUk2q"}],"identifier":"b9e3400f","html_id":"b9e3400f","key":"I9PIBKJm8X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"PROMPT_FRAME = 96\nPROMPT_POINT = (185, 137)  # (x, y) on the ball, in trimmed-frame pixels\n\nfig, ax = plt.subplots(figsize=(14, 14 * H / W))\nax.imshow(cv2.cvtColor(frames[PROMPT_FRAME], cv2.COLOR_BGR2RGB))\nax.set_xticks(range(0, W + 1, 100)); ax.set_yticks(range(0, H + 1, 50))\nax.grid(True, color=\"yellow\", alpha=0.4, linewidth=0.7)\nax.plot(*PROMPT_POINT, \"r+\", ms=20, mew=2)\nax.set_title(f\"frame {PROMPT_FRAME}\")\nplt.show()","key":"V2gHR5Z8Q9"},{"type":"outputs","id":"VxaIAgZdSQivojGUJp90G","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0147ab21d55927dfddc2ac1cf710985c","path":"/teaching-learning/ls100/build/0147ab21d55927dfddc2ac1cf710985c.png"},"text/plain":{"content":"<Figure size 1400x394.366 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"XD1iKst2Tr"}],"key":"mwW5ADRXRR"}],"identifier":"4820a45e","html_id":"4820a45e","key":"fQIZVqD5NG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 3: Run SAM 2 on the video","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D72iKNmIpH"}],"identifier":"step-3-run-sam-2-on-the-video","label":"Step 3: Run SAM 2 on the video","html_id":"step-3-run-sam-2-on-the-video","implicit":true,"key":"XaXZmK0HiT"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Writes the frames from ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QD28YS96Ad"},{"type":"inlineCode","value":"PROMPT_FRAME","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XQCPuzrg7g"},{"type":"text","value":" onward to a temporary clip and runs the SAM 2 video predictor with the clicked point as a positive prompt. The model weights (","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"inpKdd5eRZ"},{"type":"inlineCode","value":"SAM2_WEIGHTS","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"O5sA0DBITy"},{"type":"text","value":") are downloaded automatically on first use; ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"hl6oUj1tn4"},{"type":"inlineCode","value":"sam2.1_t.pt","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"TIzdzakOj7"},{"type":"text","value":" (tiny) is faster, ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rjHSCM1qbY"},{"type":"inlineCode","value":"sam2.1_b.pt","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OTvnjyZBMf"},{"type":"text","value":" (base) is more accurate. If the chosen device fails, it falls back to CPU. The result is one segmentation mask per frame.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kYzv4tAA9L"}],"key":"tfr9eopjHc"}],"identifier":"dc9a4e39","html_id":"dc9a4e39","key":"EAQSnFnZxj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import tempfile\nfrom ultralytics.models.sam import SAM2VideoPredictor\n\nSAM2_WEIGHTS = \"sam2.1_b.pt\"\n\nclip_path = Path(tempfile.mkdtemp()) / \"clip.mp4\"\nwriter = cv2.VideoWriter(str(clip_path), cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (W, H))\nfor f in frames[PROMPT_FRAME:]:\n    writer.write(f)\nwriter.release()\n\ndef run_sam2(device):\n    overrides = dict(conf=0.25, task=\"segment\", mode=\"predict\", imgsz=1024, model=SAM2_WEIGHTS, device=device, save=False, verbose=False)\n    predictor = SAM2VideoPredictor(overrides=overrides)\n    return predictor(source=str(clip_path), points=[list(PROMPT_POINT)], labels=[1])\n\ntry:\n    results = run_sam2(DEVICE)\nexcept Exception as e:\n    print(f\"{DEVICE} failed ({type(e).__name__}: {e}); retrying on CPU\")\n    results = run_sam2(\"cpu\")\n\nprint(f\"{len(results)} frames segmented\")","key":"JCmiEv1jd2"},{"type":"outputs","id":"qGR3Niah9cHYnGmBuAxTg","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Ultralytics 8.4.27 🚀 Python-3.12.12 torch-2.11.0 MPS (Apple M2 Max)\n\u001b[KDownloading https://github.com/ultralytics/assets/releases/download/v8.4.0/sam2.1_b.pt to 'sam2.1_b.pt': 100% ━━━━━━━━━━━━ 154.4MB 34.5MB/s 4.5s 4.5s<0.0s\nWARNING ⚠️ \nInference results will accumulate in RAM unless `stream=True` is passed, which can cause out-of-memory errors for large\nsources or long-running streams and videos. See https://docs.ultralytics.com/modes/predict/ for help.\n\nExample:\n    results = model(source=..., stream=True)  # generator of Results objects\n    for r in results:\n        boxes = r.boxes  # Boxes object for bbox outputs\n        masks = r.masks  # Masks object for segment masks outputs\n        probs = r.probs  # Class probabilities for classification outputs\n\n126 frames segmented\n"},"children":[],"key":"e3VccPzfwa"}],"key":"ryYBffejuO"}],"identifier":"1c7e7522","html_id":"1c7e7522","key":"NpRQsaJnOC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 4: Masks to ball positions and a visual check","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lrhF14esbP"}],"identifier":"step-4-masks-to-ball-positions-and-a-visual-check","label":"Step 4: Masks to ball positions and a visual check","html_id":"step-4-masks-to-ball-positions-and-a-visual-check","implicit":true,"key":"a7OjgFKhwx"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"For each frame, takes the mask’s centroid as the ball position and its area-equivalent diameter ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iEuvmqQU0q"},{"type":"inlineMath","value":"d = 2\\sqrt{A/\\pi}","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>d</mi><mo>=</mo><mn>2</mn><msqrt><mrow><mi>A</mi><mi mathvariant=\"normal\">/</mi><mi>π</mi></mrow></msqrt></mrow><annotation encoding=\"application/x-tex\">d = 2\\sqrt{A/\\pi}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.24em;vertical-align:-0.305em;\"></span><span class=\"mord\">2</span><span class=\"mord sqrt\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.935em;\"><span class=\"svg-align\" style=\"top:-3.2em;\"><span class=\"pstrut\" style=\"height:3.2em;\"></span><span class=\"mord\" style=\"padding-left:1em;\"><span class=\"mord mathnormal\">A</span><span class=\"mord\">/</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">π</span></span></span><span style=\"top:-2.895em;\"><span class=\"pstrut\" style=\"