"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Ep95qILIQd"},{"type":"link","url":"https://www.linkedin.com/in/souvik-mandal-phd","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"souvik-mandal-phd","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"YcHHkSiYcx"}],"urlSource":"https://www.linkedin.com/in/souvik-mandal-phd","key":"GldihgQWnR"}],"key":"Y97vRmZf4x"},{"type":"thematicBreak","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"hV1bNNm40E"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"This guide focuses on the first presentation for LS100 students, not the written proposal, which is covered separately. It is intended for the 15-minute group talk you give at the very start of the semester. It assumes you have already worked through ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"eA5xtpt6Ex"},{"type":"emphasis","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Research Methodologies: Converting the Problem to a Research Framework","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"swhy4aWEOs"}],"key":"ncaU3B6NOB"},{"type":"text","value":" (Guide 00) in this module — this talk presents that framework rather than builds it.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"nGabl1Sysy"}],"key":"p6cOET6l0b"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"In this talk, you do not need to show results as you have not run the study yet. It is rather intended to present your idea, the question or problem you want to solve, and the research plan in a coherent way, and getting feedback before you begin the research. Build the talk to invite questions, not avoid them. Keep it to a maximum of ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"hGETi9kdeH"},{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"four slides","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"vAOTfYHpM7"}],"key":"mtczxNuQet"},{"type":"text","value":" — below is what each slide may cover, and how to present well.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"bdwHXiS6h6"}],"key":"aPBRQb8adv"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Your four slides","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"aheq6pq9Tb"}],"identifier":"your-four-slides","label":"Your four slides","html_id":"your-four-slides","implicit":true,"key":"F9o5r5ahQc"},{"type":"table","position":{"start":{"line":30,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Slide","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"x4ZOAJ0LED"}],"key":"CPGMrxY1zy"},{"type":"tableCell","header":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Content","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"dBpIYa9YtS"}],"key":"R7uuT9dZgj"}],"key":"jJzNUPlWr9"},{"type":"tableRow","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"O9MLO03Bc2"}],"key":"eNxHIFcs9C"},{"type":"tableCell","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The overarching question — and why it matters","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Avz2wKgsvD"}],"key":"KIzzkcUShK"}],"key":"dQhYr59z5i"},{"type":"tableRow","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"2","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"SuDKG7AgMd"}],"key":"WKDl7o2Llz"},{"type":"tableCell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Your specific aims and hypotheses / target","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"D56SFeL4f4"}],"key":"kMyzx6JBy3"}],"key":"MmCg40yZ2f"},{"type":"tableRow","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"3","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"vtmW9ridBj"}],"key":"PIQszrDzct"},{"type":"tableCell","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Methodology and data — how each dataset answers an aim / serves the target","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"uakFIqRcMB"}],"key":"V0x3W1BOQd"}],"key":"VYblkwxRXO"},{"type":"tableRow","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"4","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"pLOYiIDzGl"}],"key":"SoBY8M7UXy"},{"type":"tableCell","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Possible outcomes, and back to the bigger question","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"sGN5flTur5"}],"key":"cKUAQDYbvA"}],"key":"WjQ536cdqR"}],"key":"ceZMwbNVfE"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"This structure mirrors how NIH grant applications begin: a one-page “Specific Aims” section that states the problem’s significance, lays out the aims and hypotheses, and closes by pointing to the expected impact (","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"neR04sHOMW"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"cite","identifier":"niaid","label":"niaid","kind":"parenthetical","position":{"start":{"line":37,"column":215},"end":{"line":37,"column":221}},"children":[{"type":"text","value":"National Institute of Allergy and Infectious Diseases (NIAID), n.d.","key":"PmqdS8JthT"}],"enumerator":"1","key":"EXlgDVnHVP"}],"key":"Jb5UZp7CSj"},{"type":"text","value":").","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"RDBvgXrnPi"}],"key":"IKvPDYGUcL"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"1. Defining and framing the problem","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"wY3DmMYYgk"}],"identifier":"id-1-defining-and-framing-the-problem","label":"1. Defining and framing the problem","html_id":"id-1-defining-and-framing-the-problem","implicit":true,"key":"mmUZXNclBo"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Slide 1","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"IuucESlBo4"}],"key":"gNjMMxqa37"}],"key":"VZcEHoNHSA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":42,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Open with the overarching issue.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"gkPi7nHmsL"}],"key":"QGSGL3lCOu"}],"key":"Kl2UAD3RG2"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Explain why the problem matters to you and why it may matter to a broader audience — especially if the full research would require substantial funding.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"TZ3v8QjXvF"}],"key":"GYWDPCR22n"}],"key":"DjA5nKj6I0"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"From the broad topic/ issue, narrow down to one specific, testable question. (“What drives X” is a topic; “Does A predict B in Y” is a question.)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"KCtO3bwGM6"}],"key":"w92vQpFioD"}],"key":"BEdVG025j4"},{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Avoid asking tautological questions","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"s7lHmCmgl1"}],"key":"KDXPFd1eHO"},{"type":"text","value":" - questions whose answer is guaranteed by the definitions involved, and no study could ever come out with different results. For example, “Does arm kinematics differ across different types of baseball or golf swings?” — logically, it must. No amount of study or data will find anything otherwise. Therefore, the question is not interesting. Instead, ask questions that investigate empirical unknowns, where the outcomes are not predetermined, and the hypotheses can be actively tested and falsified.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"vFIsVVA9gC"}],"key":"GKmFKkqO6f"}],"key":"Jh0zFR2CfP"},{"type":"listItem","spread":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Keep the question or problem statement to one sentence that your audience could repeat back to you. If they cannot, it is not yet ready for slide 1.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"NRI5GnQS2d"}],"key":"fDVGdjpjrk"}],"key":"CjgLbA1pYV"},{"type":"listItem","spread":true,"position":{"start":{"line":47,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Ideally, frame the research question by pointing out the gap: what is already known and what remains unresolved. For this presentation, that may depend on how much time you want to allocate to this slide.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"f96zlh8p3F"}],"key":"QqE3SbhD5l"}],"key":"SYddMwNe9l"}],"key":"PoOAZeBtV9"},{"type":"blockquote","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"strong","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Halp5rGjNa"}],"key":"qOJrARdlZs"},{"type":"text","value":" Open with a short story — what’s known or agreed on (the “and”), the tension or gap (the “but”), and what you propose to do about it (the “therefore”). One well-crafted sentence like this can carry the whole slide (","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"qZaVZmmLSg"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"cite","identifier":"olson2015","label":"olson2015","kind":"parenthetical","position":{"start":{"line":49,"column":235},"end":{"line":49,"column":245}},"children":[{"type":"text","value":"Olson, 2015","key":"VsylNBYJk0"}],"enumerator":"2","key":"y28duBzbkW"}],"key":"cJNNf9PHxY"},{"type":"text","value":").","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Bkck6Oi3tk"}],"key":"fCuT0GIvnb"}],"key":"JxEe3TEZfu"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"2. Breaking down the problem: specific aims and hypotheses","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"SXiMeU8DmH"}],"identifier":"id-2-breaking-down-the-problem-specific-aims-and-hypotheses","label":"2. Breaking down the problem: specific aims and hypotheses","html_id":"id-2-breaking-down-the-problem-specific-aims-and-hypotheses","implicit":true,"key":"oKcDSD91oB"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Slide 2","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"TM8QCeGWUU"}],"key":"wkGqgWKoWZ"}],"key":"xRi0krEsQs"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To solve the problem, what related questions or steps must be addressed, either in sequence or in parallel? These might include one specific research question, one testable hypothesis, or a deliverable outcome - developing a tool, or a statistical or machine learning model.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"CQBetRFeJe"}],"key":"V9Of56bobh"}],"key":"Iti5GCfzJT"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"State each as a specific aim: what you will do, and what you expect to find. Each aim (question or step) should lead to a clear hypothesis or outcome. Think of hypothesis as a specific, testable, falsifiable expectation — “if [X], then [Y], because [mechanism/ logic]” is a good template. Outcome could be a tool, data pipeline, a statistical or machine learning model.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"xApSazR6Fl"}],"key":"S6HTKluzKI"}],"key":"nEVJMXnqm8"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Check whether each aim is feasible within the time and resources you actually have.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"IfOrUcRFti"}],"key":"bmkOVSeh2E"}],"key":"tpsnS4Qmt6"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If a later aim depends entirely on an earlier one succeeding, say so and name it as a risk.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"rjENHtrOyU"}],"key":"OF7TSTKsOH"}],"key":"r3MuRjAcGq"},{"type":"listItem","spread":true,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write down the questions, hypotheses, steps, and possible outcomes in a logical sequence. This helps you to have a mental map of the logical flow.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"GYUNc02ExG"}],"key":"v5DiCbNRqc"}],"key":"T52NTRdguC"},{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This process is iterative, so you may need to revisit it and add, remove, or reorder items — this is a core part of research.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"OSKzg5fybR"}],"key":"F5lQuWRFTt"}],"key":"WUFCO8PmQx"}],"key":"TZup9R2o1c"},{"type":"blockquote","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"strong","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"xXDgPN3IFb"}],"key":"cx5uKNSTJp"},{"type":"text","value":" Keep this to two aims. Limiting the presentation to two aims makes the project feel focused rather than unfocused, even when the underlying research is ambitious. This is what NIH suggests to the grant writers as well (","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"QDM2SUYNYO"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"cite","identifier":"niaid","label":"niaid","kind":"parenthetical","position":{"start":{"line":61,"column":239},"end":{"line":61,"column":245}},"children":[{"type":"text","value":"National Institute of Allergy and Infectious Diseases (NIAID), n.d.","key":"kcsgKscDGB"}],"enumerator":"1","key":"I9UZeHk1eP"}],"key":"yg9lTWxAhL"},{"type":"text","value":").","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"etmE8eC1qq"}],"key":"WhmHCeMARV"}],"key":"GL32Btygx1"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"3. Focusing on one achievable goal: Methodology and data structure","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"ApSYAyf4KT"}],"identifier":"id-3-focusing-on-one-achievable-goal-methodology-and-data-structure","label":"3. Focusing on one achievable goal: Methodology and data structure","html_id":"id-3-focusing-on-one-achievable-goal-methodology-and-data-structure","implicit":true,"key":"yhkiY3DlBh"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Slide 3","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"vOaLV3o7q4"}],"key":"aETj44nC1C"}],"key":"rpokqElznu"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":66,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Next, focus on the first aim. Is it achievable within your available time and resources? If yes, nice. If not, limit it within your budget.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"l9pfDx7d8c"}],"key":"UofBl1FF0r"}],"key":"XKRtqh8Psy"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Name every dataset you will need, specify its type, and identify the relevant variables (for example, independent vs. dependent variables, and whether they are discrete or continuous). Then draw a direct line from each dataset to the aim it answers.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"wsCqMHJV1b"}],"key":"tWipHqkVDM"}],"key":"KeEdbwa61i"},{"type":"listItem","spread":true,"position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Explain where the data will come from, what equipment or access you will require to get the data, and how long it will take to collect the data. As a rule of thumb, ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"BaibJwXP7d"},{"type":"strong","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"consider budgeting about a third of your available time for data collection","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"h1HJoY95jH"}],"key":"eIW2nvgY5W"},{"type":"text","value":".","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"tUQ2ikD8To"}],"key":"kqyeOGqtQX"}],"key":"PRc0UjndSp"},{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"If you cannot measure a construct directly, name the proxy you will use (for example, a click count on a website standing in for “engagement”), and explain in one sentence why it is a reasonable stand-in and one way it could fail (a threat to construct validity ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"n1fFOvESoW"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"cite","identifier":"cronbach1955","label":"cronbach1955","kind":"parenthetical","position":{"start":{"line":70,"column":264},"end":{"line":70,"column":277}},"children":[{"type":"text","value":"Cronbach & Meehl, 1955","key":"OJ70TF0Twi"}],"enumerator":"3","key":"AkI3s8sjuu"}],"key":"aDoV8ZUiKM"},{"type":"text","value":").","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"XDaJ18seh1"}],"key":"IyDafSyQjz"}],"key":"RSL9Px7SmM"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Briefly note any transformation the raw data will need before analysis, and the statistical or computational method you will use.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"Bj48kyNo04"}],"key":"G07HBz2kjZ"}],"key":"sgfizbuMNm"}],"key":"IGBOpydET9"},{"type":"blockquote","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"strong","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"NQbAtKvdSV"}],"key":"Wuk05VR62s"},{"type":"text","value":" You may show this as a diagram or infographics - for example, a flow showing how each specific aim connects to the relevant dataset and method. A figure someone else could present without you standing there is doing its job; if it takes more than a few seconds to read, simplify it (","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"gB8HjPpU1a"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"cite","identifier":"midway2020","label":"midway2020","kind":"parenthetical","position":{"start":{"line":73,"column":303},"end":{"line":73,"column":314}},"children":[{"type":"text","value":"Midway, 2020","key":"RSWznXBC6Q"}],"enumerator":"4","key":"lWCmloakIZ"}],"key":"ZyCOAtQZhq"},{"type":"text","value":").","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"GXlax4OzhG"}],"key":"dK3dARaDeh"}],"key":"gid3XIO5cx"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"4. Possible outcomes and the bigger picture","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"tDUI7oXhNd"}],"identifier":"id-4-possible-outcomes-and-the-bigger-picture","label":"4. Possible outcomes and the bigger picture","html_id":"id-4-possible-outcomes-and-the-bigger-picture","implicit":true,"key":"qhAtb3vDie"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Slide 4","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"bQ4OiLaUTv"}],"key":"Ds6N5A86Iq"}],"key":"kOWS4PVNuH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"State the outcome that would tell you the analysis worked — for example, a hypothesis rejected, or a pipeline produced, or a model trained.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Kj4OkssCxv"}],"key":"Y4DdGTYQ58"}],"key":"eDkxR5tfl2"},{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Connect this specific aim back to the larger theoretical, practical, or societal question you opened with, and name the next question that follows from it.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"D0iFKqvlhN"}],"key":"UYiCAyk8ZC"}],"key":"sAAtEzVqkP"},{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Say what you will do with the feedback from this talk, keeping in mind that this presentation is a proposal, not a conclusion.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"RU0bzjRDzc"}],"key":"hyYs1iqIek"}],"key":"EUybNBboHT"}],"key":"lyBiMvLa3v"},{"type":"blockquote","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"strong","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"XpYYSWuWOD"}],"key":"wNO87YBTOW"},{"type":"text","value":" Close by answering the “who cares” question you opened with. Compressing a research question and its stakes for a general audience in a few minutes is a real, transferable skill that I would like you to gain from this exercise.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"hAQBzvFaFc"}],"key":"zPG03VD2Ra"}],"key":"kymJKYFKFe"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Delivering it well","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"Q7QsfxrXtJ"}],"identifier":"delivering-it-well","label":"Delivering it well","html_id":"delivering-it-well","implicit":true,"key":"IJWttfTQ6f"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":86,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Rehearse out loud against a timer","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"VYY4NXy42h"}],"key":"klgnk440cE"},{"type":"text","value":". If you are presenting in group (which is the case for LS100 students), calculate how much time each of you will have. However, each of you should have at least 3 minutes - that is 180 seconds. So, each second counts.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"yT4D2NLOf5"}],"key":"b6LPonhLo5"}],"key":"pmswS98mMu"},{"type":"listItem","spread":true,"position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When someone asks a question, repeat or rephrase it before you answer — it confirms you understood it, and makes sure the room heard it too.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"z82Yhxk6x6"}],"key":"QSyTg98KfY"}