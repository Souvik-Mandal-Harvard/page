ion":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pGlpGXVX3h"}],"key":"Ni5VSAts2U"}],"identifier":"2879129c","html_id":"2879129c","key":"k6DAQORsMe"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Last updated: 2026-10-15","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z2xGfDpTbC"}],"key":"dcdz9jOK0Z"},{"type":"text","value":" ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PgRj6tgh6Y"},{"type":"comment","value":"last-updated","key":"diPuR87Y80"}],"key":"DWlKwWl0oU"}],"key":"KpbQueXSGH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"link","url":"https://colab.research.google.com/github/Souvik-Mandal-Harvard/Computational-Behavioral-Sciences_LS100_Harvard/blob/main/LS100_01A_Video-data/02-video-preprocessing/LS100_module-01A_Video-Data_content-05_stage-01_Video-Processing_Trim-video-frame_LastUpdated-20261014.ipynb","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"image","url":"/teaching-learning/ls100/build/7e2db436150c38a00650f96925aa5581.svg","alt":"Open in Colab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DoClSeU2yi","urlSource":"https://colab.research.google.com/assets/colab-badge.svg"}],"urlSource":"https://colab.research.google.com/github/Souvik-Mandal-Harvard/Computational-Behavioral-Sciences_LS100_Harvard/blob/main/LS100_01A_Video-data/02-video-preprocessing/LS100_module-01A_Video-Data_content-05_stage-01_Video-Processing_Trim-video-frame_LastUpdated-20261014.ipynb","key":"pFAwWRLvpX"},{"type":"text","value":" ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NMfAu2fPXl"},{"type":"link","url":"https://codespaces.new/Souvik-Mandal-Harvard/Computational-Behavioral-Sciences_LS100_Harvard?devcontainer_path=.devcontainer%2Fdevcontainer.json","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"image","url":"/teaching-learning/ls100/build/f64bfceadefc97b376485eaeb63a6675.svg","alt":"Open in GitHub Codespaces","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j2OUz9kaG5","urlSource":"https://github.com/codespaces/badge.svg"}],"urlSource":"https://codespaces.new/Souvik-Mandal-Harvard/Computational-Behavioral-Sciences_LS100_Harvard?devcontainer_path=.devcontainer%2Fdevcontainer.json","key":"t1YNOFUA9b"}],"key":"mvHP6hDNdn"},{"type":"comment","value":"run-badges","key":"AKYBw8krbf"}],"key":"FHtsfyN3E6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import cv2\nimport matplotlib.pyplot as plt\nfrom pathlib import Path\n\nVIDEO = Path(\"/Users/souvikmandal/Documents/S06_Teaching_Mentoring_Talks/LS100/2026_Sem2/data/raw/water-polo_maya/01-F-01-TL-Back-2.mp4\")\n\ncap = cv2.VideoCapture(str(VIDEO))\nok, frame = cap.read()  # first frame (BGR)\nfps = cap.get(cv2.CAP_PROP_FPS)\nn_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\ncap.release()\nassert ok, f\"Could not read {VIDEO}\"\n\nH, W = frame.shape[:2]\nprint(f\"Width={W}, Height={H}, FPS={fps:.2f}, Frames={n_frames}\")","key":"X61YzvPtEK"},{"type":"outputs","id":"ZO_Xg7q56g4NIwblCiquK","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Width=1920, Height=1080, FPS=59.94, Frames=222\n"},"children":[],"key":"ur53jaZrDt"}],"key":"KYglAtZVgD"}],"identifier":"81c9f7e7","html_id":"81c9f7e7","key":"liJQIj9QJX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 2: Show the first frame with a pixel grid","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VL0Pygzwn5"}],"identifier":"step-2-show-the-first-frame-with-a-pixel-grid","label":"Step 2: Show the first frame with a pixel grid","html_id":"step-2-show-the-first-frame-with-a-pixel-grid","implicit":true,"key":"wraYgDwsJl"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Defines ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ysSKc3IXCE"},{"type":"inlineCode","value":"show_frame()","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rzgYoxsGz0"},{"type":"text","value":", which plots a frame with labelled x/y pixel coordinates and a yellow grid (default spacing 100 px; use a smaller ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"wLuVsncQFa"},{"type":"inlineCode","value":"grid","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"z17v3Nbu4I"},{"type":"text","value":" for finer reading). It can also overlay a crop rectangle. The call below displays the first frame so you can read off the crop coordinates.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AZHrAVHLGz"}],"key":"YyxxmMdZ8s"}],"identifier":"88c31ced","html_id":"88c31ced","key":"a7Q9az106F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def show_frame(img, crop=None, grid=100):\n    \"\"\"Show frame with pixel-coordinate grid; optionally overlay crop = (x_min, y_min, x_max, y_max).\"\"\"\n    fig, ax = plt.subplots(figsize=(14, 14 * img.shape[0] / img.shape[1]))\n    ax.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n    ax.set_xticks(range(0, img.shape[1] + 1, grid))\n    ax.set_yticks(range(0, img.shape[0] + 1, grid))\n    ax.tick_params(labeltop=True, labelright=True)\n    ax.grid(True, color=\"yellow\", alpha=0.5, linewidth=0.7)\n    if crop:\n        x0, y0, x1, y1 = crop\n        ax.add_patch(plt.Rectangle((x0, y0), x1 - x0, y1 - y0, fill=False, edgecolor=\"red\", linewidth=2))\n    ax.set_xlabel(\"x (px)\"); ax.set_ylabel(\"y (px)\")\n    plt.show()\n\nshow_frame(frame, grid=100)  # use grid=50 or 25 for finer reading","key":"uVTm3TsI52"},{"type":"outputs","id":"L2fCT2VzeMhJDPxizafZa","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2d1cac4b87e31e60eabc1ff358cc3f8b","path":"/teaching-learning/ls100/build/2d1cac4b87e31e60eabc1ff358cc3f8b.png"},"text/plain":{"content":"<Figure size 1400x787.5 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"ircVJjBfLZ"}],"key":"Mq1cqolaxG"}],"identifier":"801bc660","html_id":"801bc660","key":"UHE6oJoShm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 3: Choose and preview the crop","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r62EkTsL2s"}],"identifier":"step-3-choose-and-preview-the-crop","label":"Step 3: Choose and preview the crop","html_id":"step-3-choose-and-preview-the-crop","implicit":true,"key":"Qjr8FOX9ES"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Set ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"k77xrMcT29"},{"type":"inlineCode","value":"top_left","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AcNW5pyq1p"},{"type":"text","value":" and ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"YmdsxNeSSx"},{"type":"inlineCode","value":"bottom_right","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UR8Y3Z7kHY"},{"type":"text","value":" as ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Uc9pihJYFS"},{"type":"inlineCode","value":"(x, y)","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XUNhEj2lG0"},{"type":"text","value":" pixel coordinates read from the grid (x increases to the right, y increases downward, origin at the top-left of the frame). The other two corners follow automatically. The cell checks the crop is within the frame, makes the width and height even (required by the H.264 encoder), then shows the crop box (red) on the full frame and the cropped result. Re-run it with new values until you are happy.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ez4FyMIMJj"}],"key":"q7pnRC0Sqs"}],"identifier":"5917140b","html_id":"5917140b","key":"DPd4qc9vs2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Edit these from the grid, then re-run this cell to preview. (x right, y down; origin = top-left of frame)\ntop_left     = (500, 400) #(x, y) of top-left corner of crop rectangle\nbottom_right = (1920, 800) #(x, y) of bottom-right corner of crop rectangle\n#bottom_right = (W, H)\n# top_right = (bottom_right[0], top_left[1]); bottom_left = (top_left[0], bottom_right[1]) follow automatically.\n\nx_min, y_min = top_left\nx_max, y_max = bottom_right\nassert 0 <= x_min < x_max <= W and 0 <= y_min < y_max <= H, \"Crop out of bounds\"\n# libx264/yuv420p needs even dimensions\nx_max -= (x_max - x_min) % 2\ny_max -= (y_max - y_min) % 2\nCROP = (x_min, y_min, x_max, y_max)\n\nshow_frame(frame, crop=CROP)\ncropped = frame[y_min:y_max, x_min:x_max]\nprint(f\"Crop {CROP} -> {x_max - x_min} x {y_max - y_min}\")\nshow_frame(cropped, grid=100)","key":"olfwADHINp"},{"type":"outputs","id":"kC_ldTCdoPrJMKF20HMR-","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8b2d63586588e029e0b9e0f9c539daae","path":"/teaching-learning/ls100/build/8b2d63586588e029e0b9e0f9c539daae.png"},"text/plain":{"content":"<Figure size 1400x787.5 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"sSubqrUGek"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Crop (500, 400, 1920, 800) -> 1420 x 400\n"},"children":[],"key":"BEykd6RViM"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ae21b7c5e5fef86d8566f68e951e5bc0","path":"/teaching-learning/ls100/build/ae21b7c5e5fef86d8566f68e951e5bc0.png"},"text/plain":{"content":"<Figure size 1400x394.366 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"TJH7r9scYg"}],"key":"US54F2LpP2"}],"identifier":"a2b5a1e9","html_id":"a2b5a1e9","key":"OKVPouIasy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 4: Trim the whole video","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qQMms5RHBi"}],"identifier":"step-4-trim-the-whole-video","label":"Step 4: Trim the whole video","html_id":"step-4-trim-the-whole-video","implicit":true,"key":"eLOEglKJ8v"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Once the preview looks right, run the cell below. It applies the crop to every frame of the video using ffmpeg (or OpenCV if ffmpeg is not installed; OpenCV drops audio). The result is saved in the same folder as the input, named ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BdaJ2SGJPC"},{"type":"inlineCode","value":"<input_name>_trimmed.<extension>","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JcJZaHvYsq"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mtBfQFNHdw"}],"key":"a0OF1iNniF"}],"identifier":"8a730842","html_id":"8a730842","key":"Wz2fXUZyai"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import subprocess, shutil\n\nOUT = VIDEO.with_name(f\"{VIDEO.stem}_trimmed{VIDEO.suffix}\")\nw, h = x_max - x_min, y_max - y_min\n\nif shutil.which(\"ffmpeg\"):\n    subprocess.run(\n        [\"ffmpeg\", \"-y\", \"-loglevel\", \"error\", \"-i\", str(VIDEO), \"-vf\", f\"crop={w}:{h}:{x_min}:{y_min}\",\n         \"-c:v\", \"libx264\", \"-crf\", \"18\", \"-pix_fmt\", \"yuv420p\", \"-c:a\", \"copy\", str(OUT)],\n        check=True,\n    )\nelse:  # fallback: OpenCV (drops audio)\n    cap = cv2.VideoCapture(str(VIDEO))\n    writer = cv2.VideoWriter(str(OUT), cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (w, h))\n    while True:\n        ok, f = cap.read()\n        if not ok:\n            break\n        writer.write(f[y_min:y_max, x_min:x_max])\n    cap.release(); writer.release()\n\nprint(f'Trimmed video saved as \"{OUT.name}\" in {OUT.parent}')","key":"PmMi7UT4WL"},{"type":"outputs","id":"lUkpMAkhkYJXPSI_pOwpx","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Trimmed video saved as \"01-F-01-TL-Back-2_trimmed.mp4\" in /Users/souvikmandal/Documents/S06_Teaching_Mentoring_Talks/LS100/2026_Sem2/data/raw/water-polo_maya\n"},"children":[],"key":"kSQlmt20RX"}],"key":"zrpmlzmmDc"}],"identifier":"b7cd4744","html_id":"b7cd4744","key":"RlRf9seW4u"}],"key":"Bn55FAaeuH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"NB04: Video Pair Clip Generator","short_title":"Notebook 04 · Video Clipping","url":"/ls100-module-01a-video-data-content-04-stage-01-vi","group":"Video pre-processing"},"next":{"title":"Pose Landmarks with MediaPipe — From Local Videos & Folders Using Python","short_title":"Notebook 05 · Pose Estimation (MediaPipe)","url":"/ls100-module-01a-video-data-content-05-stage-02-cv","group":"Pose estimation (human)"}}},"domain":"http://localhost:3000"}