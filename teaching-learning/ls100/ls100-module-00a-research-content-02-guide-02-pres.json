line":19,"column":1},"end":{"line":19,"column":1}},"key":"p2TARpb2Sz"},{"type":"link","url":"https://www.linkedin.com/in/souvik-mandal-phd","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"souvik-mandal-phd","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"z15zNWlMX3"}],"urlSource":"https://www.linkedin.com/in/souvik-mandal-phd","key":"wITlGmy1Fm"}],"key":"MDlpTOnHPH"},{"type":"thematicBreak","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"cFgb5qHxBU"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"This guide focuses on the first presentation for LS100 students, not the written proposal, which is covered separately. It is intended for the 15-minute group talk you give at the very start of the semester.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"aolEyO0AFA"}],"key":"WvXZDze0Yo"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"In this talk, you do not need to show results as you have not run the study yet. It is rather intended to present your idea, the question or problem you want to solve, and the research plan in a coherent way, and getting feedback before you begin the research. Build the talk to invite questions, not avoid them. Keep it to a maximum of ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"vq3sUyFFCX"},{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"four slides","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"fey1gVQ2jz"}],"key":"Sxrql0BzHV"},{"type":"text","value":" — below is what each slide may cover, and how to present it well.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"e3wwZxzo3J"}],"key":"gc1DE5torc"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Your four slides","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"WJOfcvd4pW"}],"identifier":"your-four-slides","label":"Your four slides","html_id":"your-four-slides","implicit":true,"key":"qCJ66taCTd"},{"type":"table","position":{"start":{"line":30,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Slide","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"hLpmGL9M1K"}],"key":"SVp0tES9PX"},{"type":"tableCell","header":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Content","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"VtNJysmxgt"}],"key":"r4eng1eVzH"}],"key":"qDX83JnbRb"},{"type":"tableRow","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"LClRivyx4K"}],"key":"nPFr1CmUvU"},{"type":"tableCell","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"The overarching question — and why it matters","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"ELD4uvXOst"}],"key":"RopekKaDZF"}],"key":"sSVWhJAGFw"},{"type":"tableRow","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"2","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BJ3BmUUp73"}],"key":"xllfyQhy0O"},{"type":"tableCell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Your specific aims and hypotheses / target","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Fco0zfyRYO"}],"key":"W2o7JFxPBg"}],"key":"XxN0o3FLPy"},{"type":"tableRow","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"3","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"f7hJ30dNJ5"}],"key":"gz0mRReDln"},{"type":"tableCell","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Methodology and data — how each dataset answers an aim / serves the target","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Dfj3lWMHl2"}],"key":"ECpUk9YKOO"}],"key":"sPxKLD33Tn"},{"type":"tableRow","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"4","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"T6OH2m7a3K"}],"key":"vhp3ld22QZ"},{"type":"tableCell","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Possible outcomes, and back to the bigger question","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"LIfu7wCXJS"}],"key":"CaBPKsZXrd"}],"key":"uOmACpQoEp"}],"key":"k5BfW7s41Y"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"This structure mirrors how NIH grant applications begin: a one-page “Specific Aims” section that states the problem’s significance, lays out the aims and hypotheses, and closes by pointing to the expected impact (","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"unf769amJQ"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"cite","identifier":"niaid","label":"niaid","kind":"parenthetical","position":{"start":{"line":37,"column":215},"end":{"line":37,"column":221}},"children":[{"type":"text","value":"National Institute of Allergy and Infectious Diseases (NIAID), n.d.","key":"JXSI9h3m5H"}],"enumerator":"1","key":"HrnjyLsTMh"}],"key":"GlfTSu7nTa"},{"type":"text","value":").","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"zFRMiGIU2P"}],"key":"VUsgDOj7qU"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"1. Defining and framing the problem","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"skEPFGoR1t"}],"identifier":"id-1-defining-and-framing-the-problem","label":"1. Defining and framing the problem","html_id":"id-1-defining-and-framing-the-problem","implicit":true,"key":"P540nLg6qw"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Slide 1","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"dtXZCWvLap"}],"key":"NZNCU3PuD0"}],"key":"eRkS3Z5evm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":42,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the problem scientifically: state it as one specific, testable question, not a broad topic. (“What drives X” is a topic; “Does A predict B in Y” is a question.)","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"xL729PNW1H"}],"key":"U58bYcra1A"}],"key":"OgIFxax1lA"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Say why this is interesting to you, and why it might matter to a broader audience — especially if the full research would need substantial funding.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"bAS3iYtr1x"}],"key":"kiVhmz4RmG"}],"key":"cN7H5u8UV1"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Keep it to one sentence your audience could repeat back to you. If they can’t, it isn’t ready for slide 1.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"dNJJGVlI1r"}],"key":"xBJ6iwYz3P"}],"key":"Vo6vFHuSQ3"},{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Ideally, you would frame the research question with naming the gap — what’s known, and what isn’t — that your question sits in. But for this presentation, this depends on how much time you want to allocate to this slide.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"Ech4zoOGoz"}],"key":"t6e7rsL1wy"}],"key":"z0Kdw2VXEy"}],"key":"YhtBW3xlbc"},{"type":"blockquote","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"strong","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"mPnpyWeR2g"}],"key":"wf8xs3Ax69"},{"type":"text","value":" You might open this as a short story, not a list of facts or questions — what’s known or agreed on (the “and”), the tension or gap (the “but”), and what you propose to do about it (the “therefore”). One well-built sentence like this can carry the whole slide (","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"i1nWrIBdyE"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"cite","identifier":"olson2015","label":"olson2015","kind":"parenthetical","position":{"start":{"line":47,"column":280},"end":{"line":47,"column":290}},"children":[{"type":"text","value":"Olson, 2015","key":"tRaTel7K3J"}],"enumerator":"2","key":"nff2Fb8aWE"}],"key":"mOdeeCJEPc"},{"type":"text","value":").","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"DSF6f1bQ4G"}],"key":"FOnPxVK8wK"}],"key":"bgmLtkY0tg"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"2. Breaking down the problem: specific aims and hypotheses","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"tPi31Zj20k"}],"identifier":"id-2-breaking-down-the-problem-specific-aims-and-hypotheses","label":"2. Breaking down the problem: specific aims and hypotheses","html_id":"id-2-breaking-down-the-problem-specific-aims-and-hypotheses","implicit":true,"key":"crDEzpwzAt"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Slide 2","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"p3xeXFP4Vj"}],"key":"sI21cPOAdB"}],"key":"MjDdSY4qhT"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":52,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To solve the problem, what related specific questions are needed to be answered, or steps needed to be taken, either in sequence or in parallel? This could be answering one particular question, testing one particular hypothesis, or developing a tool, or a statistical or machine learning model.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Ygi4pMQXnV"}],"key":"zZJN7uBFwG"}],"key":"rm7rdQZ2zx"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"State each as a specific aim: what you’ll do, and what you expect to find. Each question or step should a clear hypothesis or outcome. Think of hypothesis as a specific, falsifiable answer — “if [X], then [Y], because [mechanism/ logic]” is a good template.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"E3yDBAqp4L"}],"key":"P8n5NiStBo"}],"key":"iZCdSeXcsv"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Check whether each aim is doable in the time and resources you actually have. If a later aim depends entirely on an earlier one succeeding, say so and name it as a risk.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"CPuP7ZQbUy"}],"key":"mCvc6is6rB"}],"key":"ETljpGUUWd"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Write down the questions, hypotheses, steps, and possible outcomes in a logical sequence. This process is iterative, so you may need to revisit it and add, remove, or reorder items — that’s expected.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"d7gzD7wZ5G"}],"key":"lBnflaO3OL"}],"key":"hbotEssYXZ"}],"key":"aXzzD43D9z"},{"type":"blockquote","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"J4aiLg0LAt"}],"key":"fLlYp6OqBh"},{"type":"text","value":" Keep this to two aims. Even NIH grant writers are told to limit their aims to avoid looking unfocused rather than ambitious (","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"Wh4uUz2S8m"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"cite","identifier":"niaid","label":"niaid","kind":"parenthetical","position":{"start":{"line":57,"column":145},"end":{"line":57,"column":151}},"children":[{"type":"text","value":"National Institute of Allergy and Infectious Diseases (NIAID), n.d.","key":"AdXYBLeQOw"}],"enumerator":"1","key":"WcG2EDf1IF"}],"key":"nk5o80gMAy"},{"type":"text","value":") — the same holds on one slide.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"w8PEMnHz5s"}],"key":"Aw8nAqcb48"}],"key":"j9CtgHGwhq"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"3. Focusing on one achievable goal: Methodology and data structure","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"ibsQTYrAms"}],"identifier":"id-3-focusing-on-one-achievable-goal-methodology-and-data-structure","label":"3. Focusing on one achievable goal: Methodology and data structure","html_id":"id-3-focusing-on-one-achievable-goal-methodology-and-data-structure","implicit":true,"key":"Cr3m468v6r"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Slide 3","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"szGmhurLrR"}],"key":"lVHLc68rRV"}],"key":"qNMReKxRam"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":62,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next, focus on the first question or step. Is it doable within your available time and resources?","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"xvurt8ZvOG"}],"key":"y5gOlGojKI"}],"key":"YiVRGbWPZB"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Name every dataset you’ll need and its type, and draw a direct line from each dataset to the aim it answers.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"T8msA39OTD"}],"key":"ydN63VoBhM"}],"key":"FBTVrENlTm"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Say where the data comes from, what equipment or access it needs, and how long it will take to collect. As a rule of thumb, ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"BxfFuBdmuB"},{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"consider budgeting about a third of your available time for collecting data","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"yiLHwYgrjV"}],"key":"artSXSaX2W"},{"type":"text","value":".","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"iWZYcXGf7s"}],"key":"F2dCgxp7h5"}],"key":"s49Az0yZKQ"},{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Name the proxy you’re using for anything you can’t measure directly (e.g., a click count standing in for “engagement”), and say in one sentence why it’s a reasonable stand-in — and one way it could be wrong (a threat to what methodologists call construct validity: ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"TdRqJpY5td"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"cite","identifier":"cronbach1955","label":"cronbach1955","kind":"parenthetical","position":{"start":{"line":65,"column":267},"end":{"line":65,"column":280}},"children":[{"type":"text","value":"Cronbach & Meehl, 1955","key":"HliqJGwLrx"}],"enumerator":"3","key":"DKpH8ymmLn"}],"key":"itD77WQTCa"},{"type":"text","value":").","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"q1anOckJi1"}],"key":"lYC3P8jV4z"}],"key":"WwI1UKJW8Q"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Note, briefly, any transformation the raw data needs before analysis, and the statistical or computational method you’ll use.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"T86lwmlJ75"}],"key":"oc99N3cTQi"}],"key":"KJjYfEnyZ2"}],"key":"tmuU1EDW3Q"},{"type":"blockquote","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"strong","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"iRsPOWUn3J"}],"key":"KsMLbZoZMC"},{"type":"text","value":" You may show this as a diagram or infographics, for instance, a graphics showing “from a specific aim, arrows to each dataset and method”. A figure someone else could present without you standing there is doing its job; if it takes more than a few seconds to read, simplify it (","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"l3HqTowcbs"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"cite","identifier":"midway2020","label":"midway2020","kind":"parenthetical","position":{"start":{"line":68,"column":298},"end":{"line":68,"column":309}},"children":[{"type":"text","value":"Midway, 2020","key":"bg3MFWvF2C"}],"enumerator":"4","key":"gWZEBYXupV"}],"key":"WGmxzoijZr"},{"type":"text","value":"). Watch for the usual traps: a bar chart with a non-zero y-axis, two unrelated variables on dual y-axes, or a pie chart — all common ways figures mislead rather than clarify (","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"lawjaQiWco"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"cite","identifier":"nguyen2021","label":"nguyen2021","kind":"parenthetical","position":{"start":{"line