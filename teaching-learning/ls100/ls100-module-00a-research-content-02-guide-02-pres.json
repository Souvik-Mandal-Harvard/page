e":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Connect this specific aim back to the larger theoretical, practical, or societal question you opened with, and name the next question that follows from it.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"XBSI0XJpdO"}],"key":"f0delwsckj"}],"key":"KPpfOS1yBf"},{"type":"listItem","spread":true,"position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Say what you’ll do with the feedback from this talk. This slide is a draft, not a conclusion.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"QPusamVTt8"}],"key":"AEuPdd60fJ"}],"key":"PaMPnjuEv7"}],"key":"drGRmvwFJu"},{"type":"blockquote","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"For the talk:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"s1XZWQXmmG"}],"key":"EnUGbUe1t4"},{"type":"text","value":" Close by answering the “who cares” question you opened with — bookend the talk. Compressing a research question and its stakes for a general audience in a few minutes is a real, transferable skill.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"C0PMgrwqt3"}],"key":"EsbaITYBOs"}],"key":"EwXGTUx5II"},{"type":"heading","depth":2,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Delivering it well","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"ZXSNWD3GXT"}],"identifier":"delivering-it-well","label":"Delivering it well","html_id":"delivering-it-well","implicit":true,"key":"KVl